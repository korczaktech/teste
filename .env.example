MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>/todas?retryWrites=true&w=majority
MONGODB_DATABASE=todas
OLLAMA_BASE_URL=https://morok-ollama.onrender.com
OLLAMA_MODEL=llama3.2:1b

# Generate a unique random secret with at least 32 characters and set it only in Render.
ZEUS_AUTH_SECRET=<gere-um-segredo-aleatorio-com-mais-de-32-caracteres>
ZEUS_SIGNUP_ENABLED=true

# Optional neural voice: create an Azure Speech resource and configure its values in Render.
SPEECH_KEY=
SPEECH_REGION=
