MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>/todas?retryWrites=true&w=majority
MONGODB_DATABASE=todas
OLLAMA_BASE_URL=https://morok-ollama.onrender.com
OLLAMA_MODEL=llama3.2:1b

# Generate unique random secrets; configure real values only in Render.
ZEUS_AUTH_SECRET=<segredo-aleatorio-de-pelo-menos-32-caracteres>
ZEUS_SIGNUP_ENABLED=true
ZEUS_CONNECTOR_ENCRYPTION_KEY=<chave-aleatoria-hexadecimal-de-64-caracteres>

# Azure Speech neural TTS (optional until a Speech resource is created).
SPEECH_KEY=
SPEECH_REGION=

# Google OAuth app credentials. Register this callback URI in Google Cloud Console:
# https://zeus-api-cm2d.onrender.com/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://zeus-api-cm2d.onrender.com/api/connectors/google/callback

# Microsoft Entra app credentials. Register this callback URI in the app registration:
# https://zeus-api-cm2d.onrender.com/api/connectors/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://zeus-api-cm2d.onrender.com/api/connectors/microsoft/callback

# Korczak product API base URLs (optional; defaults point to the deployed APIs).
NEXUS_API_BASE_URL=https://kzdoc.onrender.com/api/v1
NEXA_API_BASE_URL=https://kz-nexa.onrender.com/v1
